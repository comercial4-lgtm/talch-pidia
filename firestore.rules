rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Global Safety Net (Default-Deny Catch-All)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Hardened Global Helpers
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedSignedIn() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedSignedIn() && (
        request.auth.token.email == 'comercial4@talcha.com.br' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // =========================================================================
    // Entity Validation Blueprints (Anti-Update-Gap)
    // =========================================================================
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'role', 'tier', 'providerId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'role', 'tier', 'providerId', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.role in ['partner', 'admin']
        && data.tier in ['prata', 'ouro', 'black']
        && data.providerId is string
        && data.providerId.size() >= 1
        && data.providerId.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'lgpdConsent', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'email', 'company', 'whatsapp', 'city', 'lgpdConsent', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == userId
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && (!data.keys().hasAny(['company']) || (data.company is string && data.company.size() <= 150))
        && (!data.keys().hasAny(['whatsapp']) || (data.whatsapp is string && data.whatsapp.size() <= 40))
        && (!data.keys().hasAny(['city']) || (data.city is string && data.city.size() <= 100))
        && data.lgpdConsent is bool
        && data.updatedAt is timestamp;
    }

    function isValidSavedCarta(data, userId, cartaId) {
      return data.keys().hasAll([
          'id', 'uid', 'ownerId', 'name', 'businessType', 'itemCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'uid', 'ownerId', 'name', 'establishmentName', 'businessType',
          'audienceProfile', 'operatingHours', 'menuHighlights', 'serviceFormat',
          'cartaTitle', 'itemCount', 'customBlendIds', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == cartaId
        && isValidId(data.uid)
        && data.uid == userId
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 140
        && (!data.keys().hasAny(['establishmentName']) || (data.establishmentName is string && data.establishmentName.size() <= 150))
        && data.businessType is string
        && data.businessType.size() >= 1
        && data.businessType.size() <= 80
        && (!data.keys().hasAny(['audienceProfile']) || (data.audienceProfile is string && data.audienceProfile.size() <= 200))
        && (!data.keys().hasAny(['operatingHours']) || (data.operatingHours is string && data.operatingHours.size() <= 120))
        && (!data.keys().hasAny(['menuHighlights']) || (data.menuHighlights is string && data.menuHighlights.size() <= 500))
        && (!data.keys().hasAny(['serviceFormat']) || (data.serviceFormat is string && data.serviceFormat.size() <= 160))
        && (!data.keys().hasAny(['cartaTitle']) || (data.cartaTitle is string && data.cartaTitle.size() <= 160))
        && (data.itemCount is int || data.itemCount is float)
        && data.itemCount >= 1
        && data.itemCount <= 20
        && (!data.keys().hasAny(['customBlendIds']) || (
          data.customBlendIds is list
          && data.customBlendIds.size() <= 20
          && (data.customBlendIds.size() == 0 || (data.customBlendIds[0] is string && data.customBlendIds[0].size() <= 80))
        ))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCartaCha(data, cartaId) {
      return data.keys().hasAll([
          'id', 'uid', 'ownerId', 'nome', 'segmento', 'itensCount',
          'statusProposta', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'uid', 'ownerId', 'nome', 'estabelecimento', 'segmento',
          'formatoServico', 'itensCount', 'blends', 'statusProposta',
          'observacoes', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == cartaId
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.nome is string
        && data.nome.size() >= 1
        && data.nome.size() <= 140
        && (!data.keys().hasAny(['estabelecimento']) || (data.estabelecimento is string && data.estabelecimento.size() <= 150))
        && data.segmento is string
        && data.segmento.size() >= 1
        && data.segmento.size() <= 80
        && (!data.keys().hasAny(['formatoServico']) || (data.formatoServico is string && data.formatoServico.size() <= 160))
        && (data.itensCount is int || data.itensCount is float)
        && data.itensCount >= 1
        && data.itensCount <= 20
        && (!data.keys().hasAny(['blends']) || (
          data.blends is list
          && data.blends.size() <= 20
          && (data.blends.size() == 0 || (data.blends[0] is string && data.blends[0].size() <= 80))
        ))
        && data.statusProposta in ['pendente', 'em_analise', 'aprovada']
        && (!data.keys().hasAny(['observacoes']) || (data.observacoes is string && data.observacoes.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidB2BLead(data, leadId) {
      return data.keys().hasAll([
          'id', 'uid', 'ownerId', 'name', 'company', 'email', 'interestType',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'uid', 'ownerId', 'name', 'company', 'role', 'whatsapp',
          'email', 'city', 'estimatedQuantity', 'interestType',
          'recommendedTeaName', 'notes', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == leadId
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && data.company is string
        && data.company.size() >= 1
        && data.company.size() <= 150
        && (!data.keys().hasAny(['role']) || (data.role is string && data.role.size() <= 100))
        && (!data.keys().hasAny(['whatsapp']) || (data.whatsapp is string && data.whatsapp.size() <= 40))
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && (!data.keys().hasAny(['city']) || (data.city is string && data.city.size() <= 100))
        && (!data.keys().hasAny(['estimatedQuantity']) || (data.estimatedQuantity is string && data.estimatedQuantity.size() <= 120))
        && data.interestType in ['proposta', 'experimentar', 'carta', 'especialista', 'evento']
        && (!data.keys().hasAny(['recommendedTeaName']) || (data.recommendedTeaName is string && data.recommendedTeaName.size() <= 160))
        && (!data.keys().hasAny(['notes']) || (data.notes is string && data.notes.size() <= 1000))
        && data.status in ['novo', 'em_atendimento', 'concluido']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSecurityAuditLog(data) {
      return data.keys().hasAll([
          'uid', 'actorUid', 'action', 'resource', 'severity', 'createdAt'
        ])
        && data.keys().hasOnly([
          'uid', 'actorUid', 'action', 'resource', 'severity', 'createdAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && isValidId(data.actorUid)
        && data.actorUid == request.auth.uid
        && data.action is string
        && data.action.size() >= 1
        && data.action.size() <= 80
        && data.resource is string
        && data.resource.size() >= 1
        && data.resource.size() <= 160
        && data.severity in ['info', 'warn', 'error']
        && data.createdAt is timestamp;
    }

    // =========================================================================
    // Collection: /admins/{userId}
    // =========================================================================
    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create, update, delete: if false;
    }

    // =========================================================================
    // Collection: /users/{userId}
    // =========================================================================
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;

      allow create: if isVerifiedSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && isOwner(userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().tier == 'prata'
        && (incoming().role == 'partner' || (incoming().role == 'admin' && isAdmin()));

      allow update: if isVerifiedSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().tier == existing().tier
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'providerId', 'updatedAt'])
          )
        );

      allow delete: if isVerifiedSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());

      // =======================================================================
      // Subcollection (PII Isolation): /users/{userId}/private/info
      // =======================================================================
      match /private/info {
        allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
        allow list: if false;

        allow create: if isVerifiedSignedIn()
          && isValidId(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && (isOwner(userId) || isAdmin())
          && incoming().updatedAt == request.time
          && (
            exists(/databases/$(database)/documents/users/$(userId))
            || existsAfter(/databases/$(database)/documents/users/$(userId))
          );

        allow update: if isVerifiedSignedIn()
          && isValidId(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && (
            isAdmin()
            || (
              isOwner(userId)
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'email', 'company', 'whatsapp', 'city', 'lgpdConsent', 'updatedAt'
              ])
            )
          );

        allow delete: if isVerifiedSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      }

      // =======================================================================
      // Subcollection: /users/{userId}/cartas/{cartaId}
      // =======================================================================
      match /cartas/{cartaId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(cartaId) && (
          isAdmin()
          || (isOwner(userId) && existing().ownerId == request.auth.uid && existing().uid == request.auth.uid)
        );

        allow list: if isSignedIn()
          && isValidId(userId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid
          && existing().uid == request.auth.uid;

        allow create: if isVerifiedSignedIn()
          && isValidId(userId)
          && isValidId(cartaId)
          && isValidSavedCarta(incoming(), userId, cartaId)
          && isOwner(userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isVerifiedSignedIn()
          && isValidId(userId)
          && isValidId(cartaId)
          && isValidSavedCarta(incoming(), userId, cartaId)
          && incoming().id == existing().id
          && incoming().uid == existing().uid
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && (
            isAdmin()
            || (
              isOwner(userId)
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'establishmentName', 'businessType', 'audienceProfile',
                'operatingHours', 'menuHighlights', 'serviceFormat', 'cartaTitle',
                'itemCount', 'customBlendIds', 'updatedAt'
              ])
            )
          );

        allow delete: if isVerifiedSignedIn() && isValidId(userId) && isValidId(cartaId) && (
          isAdmin()
          || (isOwner(userId) && existing().ownerId == request.auth.uid)
        );
      }
    }

    // =========================================================================
    // Collection: /cartas_cha/{cartaId}
    // =========================================================================
    match /cartas_cha/{cartaId} {
      allow get: if isSignedIn() && isValidId(cartaId) && (
        isAdmin() || (existing().ownerId == request.auth.uid && existing().uid == request.auth.uid)
      );

      allow list: if isSignedIn()
        && existing().ownerId == request.auth.uid
        && existing().uid == request.auth.uid;

      allow create: if isVerifiedSignedIn()
        && isValidId(cartaId)
        && isValidCartaCha(incoming(), cartaId)
        && incoming().statusProposta == 'pendente'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedSignedIn()
        && isValidId(cartaId)
        && isValidCartaCha(incoming(), cartaId)
        && incoming().id == existing().id
        && incoming().uid == existing().uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().ownerId == request.auth.uid
            && existing().statusProposta != 'aprovada'
            && incoming().statusProposta == existing().statusProposta
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'nome', 'estabelecimento', 'segmento', 'formatoServico',
              'itensCount', 'blends', 'observacoes', 'updatedAt'
            ])
          )
        );

      allow delete: if isVerifiedSignedIn() && isValidId(cartaId) && (
        isAdmin() || existing().ownerId == request.auth.uid
      );
    }

    // =========================================================================
    // Collection: /b2b_leads/{leadId}
    // =========================================================================
    match /b2b_leads/{leadId} {
      allow get: if isVerifiedSignedIn() && isValidId(leadId) && (
        isAdmin() || existing().ownerId == request.auth.uid
      );

      allow list: if isVerifiedSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isVerifiedSignedIn()
        && isValidId(leadId)
        && isValidB2BLead(incoming(), leadId)
        && incoming().status == 'novo'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedSignedIn()
        && isValidId(leadId)
        && isValidB2BLead(incoming(), leadId)
        && incoming().id == existing().id
        && incoming().uid == existing().uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().ownerId == request.auth.uid
            && existing().status != 'concluido'
            && incoming().status == existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'company', 'role', 'whatsapp', 'email', 'city',
              'estimatedQuantity', 'interestType', 'recommendedTeaName',
              'notes', 'updatedAt'
            ])
          )
        );

      allow delete: if isVerifiedSignedIn() && isValidId(leadId) && (
        isAdmin() || existing().ownerId == request.auth.uid
      );
    }

    // =========================================================================
    // Collection: /security_audit_logs/{logId}
    // =========================================================================
    match /security_audit_logs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if false;

      allow create: if isVerifiedSignedIn()
        && isValidId(logId)
        && isValidSecurityAuditLog(incoming())
        && incoming().createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
